# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Core ---
SECRET_KEY=replace-with-a-freshly-generated-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme required, e.g. https://clips.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Dev can omit this (defaults to SQLite). Production (Oracle box) uses Postgres:
# DATABASE_URL=postgres://zenkai:password@127.0.0.1:5432/zenkai

# --- Async worker ---
Q_WORKERS=2

# --- Object storage (Cloudflare R2) ---
# Leave USE_S3=False for local dev to store media on the local filesystem.
USE_S3=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zenkai-clips
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# Public domain (R2 custom domain via Cloudflare) that serves converted clips:
R2_PUBLIC_DOMAIN=clips-media.example.com

# --- Production security (only applied when DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
