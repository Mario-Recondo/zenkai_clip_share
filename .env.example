# Copy to ".env" in the project root and fill in real values.
# Never commit .env — it is listed in .gitignore.

# Django (optional but recommended for real deployments)
# DJANGO_SECRET_KEY=generate-a-long-random-string

# AWS IAM user (used by boto3 / presigned URLs when running locally)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# e.g. us-east-1, eu-west-1
AWS_DEFAULT_REGION=your-aws-region
